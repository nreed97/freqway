# Freqway — Docker / Compose settings
#
# Copy to .env (cp .env.example .env) and edit. Compose reads .env from the
# directory you run it in; in Arcane, paste these into the project's .env.
# Every value is optional: the defaults below are used when a line is unset.

# Host port the app is published on (container listens on 8080).
FREQWAY_PORT=8080

# Branch, tag or commit to build from (deploy/arcane/compose.yaml only).
FREQWAY_REF=main

# User-Agent sent to the Nominatim geocoder. Its usage policy asks for
# something that identifies your instance, ideally with contact details.
# Avoid double quotes.
NOMINATIM_USER_AGENT=Freqway/1.0 (ham radio route planner)

# Base image versions (build args). Changing these triggers a rebuild.
NODE_VERSION=22
NGINX_VERSION=stable
